#!groovy

@Library('ci_scripts')
@Library('repo_jenkins_lib')
import com.amarula.build.Build
import com.amarula.ui.Ui

node('android-build') {
    def dockerImage = 'gerrit-plugin-builder:1.0'
    def credentials = 'gerrithub'

    def ui = new Ui.Builder(this)
        .addStringParameter("BRANCH", "main", "Branch or tag to be built")
        .addStringParameter(
            "GERRIT_REF_TAGS",
            "v3.14.0",
            "Comma-separated Gerrit tags to build against (e.g. v3.14.0,v3.15.0)")
        .addBooleanParameter("KEEP_BUILD", false, "If you want to keep build select it")
        .build()

    def repoUrl = 'https://gerrithub.io/a/amarula/chatgpt-code-review-gerrit-plugin.git'
    def ver = new Build(this, env, credentials)

    final def GERRIT_REPO = 'https://gerrit.googlesource.com/gerrit'
    final def GERRIT_TAGS = GERRIT_REF_TAGS?.trim() ?: 'v3.14.0'
    final def gerritVersions = GERRIT_TAGS.split(',').collect { it.trim() }.findAll { !it.isEmpty() }

    final def options = ['dockerImage': dockerImage, branch: "${BRANCH}", 'history': true,
        intermediateDocker: false, proxyCache: false]

    def isTag = false
    def tagCommitish = ''
    def branchParam = BRANCH?.trim() ?: 'main'
    def artifactPaths = []

    try {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            ver.build(repoUrl, [
                'Setup': {
                    // Check whether branchParam is a tag and capture its commit
                    // SHA while we're inside Docker with the repo checked out.
                    isTag = sh(
                        returnStatus: true,
                        script: 'git rev-parse --verify "refs/tags/' + branchParam + '" >/dev/null 2>&1'
                    ) == 0
                    if (isTag) {
                        tagCommitish = sh(
                            returnStdout: true,
                            script: 'git rev-parse HEAD'
                        ).trim()
                    }

                    // Move the plugin source into plugin-source/, keeping the
                    // workspace root clean.  plugin-source/ is read-only shared
                    // input for the parallel builds.
                    sh """#!/bin/bash -el
                        if [ ! -d plugin-source ]; then
                            mkdir plugin-source
                            shopt -s dotglob nullglob
                            for item in * .*; do
                                case "\${item}" in plugin-source|.|..) continue ;; esac
                                if [ -e "\${item}" ]; then
                                    mv "\${item}" plugin-source/
                                fi
                            done
                            shopt -u dotglob nullglob
                        fi
                    """
                },

                'Build': {
                    def builds = [:]
                    gerritVersions.each { gerritVersion ->
                        def shortVersion = gerritVersion.replaceAll(/^v(\d+\.\d+).*/, '$1')
                        def apiVersion = gerritVersion.replaceAll(/^v/, '')
                        def jarName = "reviewai-gerrit-plugin-${shortVersion}.jar"

                        builds["gerrit-${shortVersion}"] = {
                            sh """#!/bin/bash -el
                                # PWD is the plugin checkout directory (set by Build class).
                                # plugin-source/ was created here by Setup.
                                BUILD_DIR="\${WORKSPACE}/build-${shortVersion}"
                                rm -rf "\${BUILD_DIR}"
                                mkdir -p "\${BUILD_DIR}"

                                # ---- Copy plugin source (each parallel branch gets its own
                                #      copy so we can patch Gerrit-ApiVersion independently) ----
                                cp -r "\${PWD}/plugin-source" "\${BUILD_DIR}/plugin-source"

                                # ---- Clone Gerrit for this version ----
                                echo "Cloning Gerrit at tag ${gerritVersion}..."
                                git clone --depth 1 --branch "${gerritVersion}" \
                                    --recurse-submodules --shallow-submodules \
                                    "${GERRIT_REPO}" "\${BUILD_DIR}/gerrit"

                                # ---- Patch Gerrit-ApiVersion in BUILD ----
                                # Matches only the version value inside the existing
                                # quoted string, preserving the surrounding \" and \",.
                                sed -i 's/"Gerrit-ApiVersion: [^"]*"/"Gerrit-ApiVersion: ${apiVersion}"/' \
                                    "\${BUILD_DIR}/plugin-source/BUILD"

                                # ---- Symlink plugin into Gerrit's plugins/ directory ----
                                ln -sfn "\${BUILD_DIR}/plugin-source" \
                                    "\${BUILD_DIR}/gerrit/plugins/reviewai-gerrit-plugin"

                                # ---- Symlink external deps MODULE.bazel ----
                                ln -sfn "\${BUILD_DIR}/plugin-source/external_plugin_deps.MODULE.bazel" \
                                    "\${BUILD_DIR}/gerrit/plugins/external_plugin_deps.MODULE.bazel"

                                # ---- Bazel build ----
                                cd "\${BUILD_DIR}/gerrit"
                                JOBS="\${BAZEL_JOBS:-\$(nproc)}"
                                bazel build \
                                    --lockfile_mode=update \
                                    --enable_bzlmod \
                                    --jobs="\${JOBS}" \
                                    //plugins/reviewai-gerrit-plugin:reviewai-gerrit-plugin

                                # ---- Copy jar with versioned name to workspace root ----
                                cp -L "\${BUILD_DIR}/gerrit/bazel-bin/plugins/reviewai-gerrit-plugin/reviewai-gerrit-plugin.jar" \
                                    "\${WORKSPACE}/${jarName}"
                            """
                            artifactPaths.add(jarName)
                            echo "Built ${jarName} for Gerrit ${gerritVersion}"
                        }
                    }
                    parallel builds
                }
            ], options)
        }

        if (currentBuild.result == 'FAILURE' || currentBuild.result == 'UNSTABLE') {
            explainError()
        } else {
            notification.monitoredStage('Deploy') {
                artifactPaths.each { jar ->
                    archiveArtifacts artifacts: jar, fingerprint: true, onlyIfSuccessful: true
                }

                if (KEEP_BUILD.toBoolean()) {
                    // Only create a GitHub release when branchParam is a real tag.
                    if (branchParam != 'master' && isTag) {
                        createGitHubRelease(
                            credentialId: 'github-release-token',
                            repository: 'amarula/reviewai-gerrit-plugin',
                            tag: branchParam,
                            commitish: tagCommitish,
                            generateReleaseNotes: true
                        )
                        // Upload each versioned jar
                        artifactPaths.each { jar ->
                            uploadGithubReleaseAsset(
                                credentialId: 'github-release-token',
                                repository: 'amarula/reviewai-gerrit-plugin',
                                tagName: branchParam,
                                uploadAssets: [[filePath: jar]],
                            )
                        }
                    }
                    currentBuild.setKeepLog(true)
                }

                notification.notifySuccess()
            }
        }
    } finally {
        cleanWs()
    }
}
