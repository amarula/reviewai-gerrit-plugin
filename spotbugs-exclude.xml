<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- AiPrompt must remain extensible for plugin prompt subclasses. Preserve
      constructor failure when prompt resources cannot be loaded. Accept the
      theoretical finalizer risk for this constructor's trusted plugin usage;
      this exclusion does not prevent untrusted subclasses or finalizer attacks. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.prompt.AiPrompt"/>
        <Method name="&lt;init&gt;" params="com.googlesource.gerrit.plugins.reviewai.config.Configuration" returns="void"/>
    </Match>

    <!-- loadDefinitions builds an unmodifiable list with Stream.toList(). Its
      SpecializedReviewAgentDefinition elements are immutable Lombok @Value
      objects containing only strings. Returning the cache cannot expose mutable
      state; retain shared reads without unnecessary defensive copies. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.prompt.agents.level2.SpecializedReviewAgentDefinitions"/>
        <Method name="load" params="" returns="java.util.List"/>
        <Field name="cachedDefinitions" type="java.util.List"/>
    </Match>

    <!-- getDefaultAiMessageReview has no current overrides and reads prompt
      values loaded before this call. Preserve its extension contract; future
      overrides must not depend on subclass state during construction. -->
    <Match>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.prompt.agents.level1.commitmessage.AiPromptReviewCommitMessage"/>
        <Method name="&lt;init&gt;" params="com.googlesource.gerrit.plugins.reviewai.config.Configuration,com.googlesource.gerrit.plugins.reviewai.aibackend.common.model.data.ChangeSetData,com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.api.gerrit.GerritChange,com.googlesource.gerrit.plugins.reviewai.interfaces.aibackend.common.client.code.context.ICodeContextPolicy" returns="void"/>
    </Match>

    <!-- Collector dispatch is intentional: all four current getCollectorMessage
      implementations read only prompt values loaded before this call. Future
      overrides must not depend on subclass state during construction. -->
    <Match>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.prompt.agents.level2.AiPromptSpecializedReviewCollector"/>
        <Method name="&lt;init&gt;" params="com.googlesource.gerrit.plugins.reviewai.config.Configuration,com.googlesource.gerrit.plugins.reviewai.aibackend.common.model.data.ChangeSetData,com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.api.gerrit.GerritChange,com.googlesource.gerrit.plugins.reviewai.interfaces.aibackend.common.client.code.context.ICodeContextPolicy,java.lang.String" returns="void"/>
    </Match>

    <!-- concernLedgerOperations has no current overrides and returns a final
      field initialized by the completed superclass constructor. Preserve its
      extension contract; future overrides must not depend on subclass state
      during construction. -->
    <Match>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.aibackend.langchain.client.api.agents.level2.LangChainSpecializedAgentReviewClient"/>
        <Method name="&lt;init&gt;" params="com.googlesource.gerrit.plugins.reviewai.config.Configuration,com.googlesource.gerrit.plugins.reviewai.interfaces.aibackend.common.client.code.context.ICodeContextPolicy,com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.api.gerrit.GerritClient,com.googlesource.gerrit.plugins.reviewai.localization.Localizer,com.googlesource.gerrit.plugins.reviewai.data.PluginDataHandlerProvider,com.googlesource.gerrit.plugins.reviewai.web.ReviewAgentConversationStore,com.googlesource.gerrit.plugins.reviewai.aibackend.langchain.memory.PluginChatMemoryStore,java.util.concurrent.Executor,com.googlesource.gerrit.plugins.reviewai.aibackend.common.client.api.git.GitRepoFiles,com.googlesource.gerrit.plugins.reviewai.metrics.ReviewAiMetrics" returns="void"/>
    </Match>

    <!-- DetailedTokenUsage intentionally inherits TokenUsage equality and
      hashing. Cache counts provide cost details but are not part of equality;
      preserve comparisons based on the superclass token counts. -->
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
        <Class name="com.googlesource.gerrit.plugins.reviewai.metrics.cost.DetailedTokenUsage"/>
    </Match>
</FindBugsFilter>
