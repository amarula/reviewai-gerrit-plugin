{
  "name": "format_specialized_historical_repetition",
  "description": "Mark raw Level 2 concerns repeated against past comments.",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "annotations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "concern_id": { "type": "string" },
            "repeated": { "type": "boolean" },
            "past_comment_id": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["concern_id", "repeated", "past_comment_id", "reason"]
        }
      }
    },
    "required": ["annotations"]
  }
}
