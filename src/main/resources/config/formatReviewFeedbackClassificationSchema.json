{
  "name": "format_review_feedback_classification",
  "description": "Classify addressed comments and update distilled review feedback.",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "classifications": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "comment_id": { "type": "string" },
            "category": {
              "type": "string",
              "enum": ["GENERIC", "IRRELEVANT", "CONCERN", "DISMISS_CONCERN"]
            },
            "concern_id": { "type": "string" },
            "review_control_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": ["DISABLE", "ENABLE"]
                  },
                  "target": {
                    "type": "string",
                    "enum": [
                      "PATCHSET",
                      "COMMIT_MESSAGE",
                      "CORRECTNESS",
                      "TESTABILITY",
                      "CODE_QUALITY",
                      "DOCUMENTATION",
                      "SECURITY"
                    ]
                  }
                },
                "required": ["operation", "target"]
              }
            }
          },
          "required": [
            "comment_id",
            "category",
            "concern_id",
            "review_control_actions"
          ]
        }
      },
      "generic_feedback": { "type": "string" },
      "concern_feedback": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "concern_id": { "type": "string" },
            "summary": { "type": "string" }
          },
          "required": ["concern_id", "summary"]
        }
      },
      "condition_label_disabled_specialized_agents": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "CORRECTNESS",
            "TESTABILITY",
            "CODE_QUALITY",
            "DOCUMENTATION",
            "SECURITY"
          ]
        },
        "uniqueItems": true
      }
    },
    "required": [
      "classifications",
      "generic_feedback",
      "concern_feedback",
      "condition_label_disabled_specialized_agents"
    ]
  }
}
