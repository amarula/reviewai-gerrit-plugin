{
  "name": "format_specialized_triage",
  "description": "Provide Level 2 specialized review triage decisions.",
  "strict": false,
  "schema": {
    "type": "object",
    "properties": {
      "agents": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "history_context": {
              "type": "string"
            },
            "custom_instructions": {
              "type": "string"
            }
          },
          "required": [
            "agent",
            "enabled",
            "reason",
            "history_context",
            "custom_instructions"
          ]
        }
      },
      "consolidation_context": {
        "type": "string"
      }
    },
    "required": [
      "agents",
      "consolidation_context"
    ]
  }
}
