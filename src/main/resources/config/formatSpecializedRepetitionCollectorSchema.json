{
  "name": "format_specialized_repetition",
  "description": "Mark specialized replies repeated against history.",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "replies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "repeated": { "type": "boolean" },
            "repetition_reply_id": { "type": "string" }
          },
          "required": ["id", "repeated", "repetition_reply_id"]
        }
      }
    },
    "required": ["replies"]
  }
}
