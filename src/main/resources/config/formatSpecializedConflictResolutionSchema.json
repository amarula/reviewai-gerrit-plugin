{
  "name": "format_specialized_conflict_resolution",
  "description": "Resolve conflicts between concerns and dismissed concerns.",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "concerns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "merged_concern_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "owner_agent": {
              "type": "string",
              "enum": [
                "COMMIT_MESSAGE",
                "CORRECTNESS",
                "TESTABILITY",
                "CODE_QUALITY",
                "DOCUMENTATION",
                "SECURITY"
              ]
            },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "reasoning": { "type": "string" },
            "preexisting": { "type": "boolean" },
            "repeated": { "type": "boolean" },
            "past_comment_id": { "type": "string" },
            "repeated_reason": { "type": "string" },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "filename": { "type": "string" },
                  "lineNumber": { "type": "integer" },
                  "codeSnippet": { "type": "string" }
                },
                "required": ["filename", "lineNumber", "codeSnippet"]
              }
            }
          },
          "required": [
            "id",
            "merged_concern_ids",
            "owner_agent",
            "type",
            "description",
            "reasoning",
            "preexisting",
            "repeated",
            "past_comment_id",
            "repeated_reason",
            "locations"
          ]
        }
      },
      "dismissed_concerns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "description": { "type": "string" },
            "reasoning": { "type": "string" },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "filename": { "type": "string" },
                  "lineNumber": { "type": "integer" },
                  "codeSnippet": { "type": "string" }
                },
                "required": ["filename", "lineNumber", "codeSnippet"]
              }
            }
          },
          "required": ["type", "description", "reasoning", "locations"]
        }
      }
    },
    "required": ["concerns", "dismissed_concerns"]
  }
}
